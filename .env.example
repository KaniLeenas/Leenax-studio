# Copy to .env and fill in every value.  Never commit .env.
# Generate strong values with:  openssl rand -base64 32   (or any password manager)

# Database and cache
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me

# Private object storage (SeaweedFS S3) credentials
S3_ACCESS_KEY=leenax
S3_SECRET_KEY=change-me-at-least-16-chars

# Encrypts your AI provider API keys (Runway, Kling, Luma, Gemini...). Must be 32 random bytes in Base64:
#   openssl rand -base64 32
# Back this value up somewhere safe. If you lose or change it, saved API keys can't be read and must be entered again.
LEENAX_MASTER_KEY=

# One-time token for creating your owner account. Remove it after setup.
SETUP_TOKEN=change-me

# Optional outbound email; required before enabling public registration.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true

# Shared secret between the backend and the render service (any long random string).
# PowerShell: [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))
RENDERER_TOKEN=change-me-to-a-long-random-string
# Memory for video exports (4K exports need more)
RENDERER_MEMORY=4g

# --- Social publishing (Phase 6) -------------------------------------------
# Address you open the studio at. Register these callback URLs in each developer console:
#   <PUBLIC_BASE_URL>/api/v1/social/oauth/google/callback   (Google Cloud → OAuth client → Authorized redirect URIs)
#   <PUBLIC_BASE_URL>/api/v1/social/oauth/meta/callback     (Meta app → Facebook Login for Business → Valid OAuth Redirect URIs)
#   <PUBLIC_BASE_URL>/api/v1/social/oauth/tiktok/callback   (TikTok app → Login Kit → Redirect URI; TikTok needs https)
PUBLIC_BASE_URL=http://localhost:8088
# YouTube: Google Cloud OAuth client (Web application) with YouTube Data API v3, YouTube Analytics API and YouTube Reporting API enabled
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# E6 YouTube SEO: searches a day (shared by everyone; YouTube's default allowance is about 100) and days a search is reused.
SEO_DAILY_SEARCHES=100
SEO_CACHE_DAYS=7
# Facebook Pages + Instagram: Meta Business app with Facebook Login for Business
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
# TikTok: app with Login Kit + Content Posting API (Direct Post enabled)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# When YouTube's daily reach reports (impressions, click-through rate) are imported, in UTC (Spring cron).
YOUTUBE_REACH_IMPORT_CRON=0 20 14 * * *

# --- Backups (Phase 7) --------------------------------------------------------
# The "backup" service writes ./backups/<timestamp>/ every day at BACKUP_TIME (in TZ) and keeps BACKUP_KEEP of them.
# Copy the backups folder off this PC regularly, and keep this .env (LEENAX_MASTER_KEY) with it.
TZ=Asia/Colombo
BACKUP_TIME=03:15
BACKUP_KEEP=14

# --- Local use (defaults) -------------------------------------------------
# Studio:  http://localhost:8088      Media: http://localhost:8333
COOKIE_SECURE=false
MEDIA_PUBLIC_URL=http://localhost:8333
WEB_BIND=127.0.0.1
WEB_PORT=8088

# --- Internet deployment (see deploy/README-deploy.md) ----------------------
# COOKIE_SECURE=true
# MEDIA_PUBLIC_URL=https://media.your-domain.com

# Upload limit (backend / nginx). Keep the nginx value slightly larger.
MAX_UPLOAD_SIZE=2GB
MAX_UPLOAD_SIZE_NGINX=2100m

# Course documents (E2). Optional; these are the defaults.
# MAX_DOCUMENT_BYTES=104857600
# MAX_DOCUMENT_PAGES=500
# DOCSERVICE_MEMORY=2g
# Syllabus analysis (E3): most characters of document text sent to the AI at once.
# SYLLABUS_MAX_SOURCE_CHARS=150000

# Agent execution queue. Per-user and per-project active-run limits protect shared provider credits and CPU.
OLLAMA_BASE_URL=http://host.docker.internal:11434
AGENT_TICK_MS=2000
AGENT_ALLOW_PAID_MODELS=false
AGENT_MAX_CONCURRENT_PER_USER=2
AGENT_MAX_CONCURRENT_PER_PROJECT=4
# Shared only by backend and the private document/agent service. Generate with: openssl rand -hex 32
AGENT_SERVICE_TOKEN=
